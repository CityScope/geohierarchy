# Sphinx build output
docs/_build/
_build/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/

# Documentation build files
docs/build/

# Python egg files
*.egg-info/
dist/
build/

# Test / lint / tool caches (specific dirs only -- do NOT use a generic
# "*cache*" glob, it also matches legitimate source files such as
# spatial_cache.py / test_spatial_cache.py)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor backups / scratch files
*.bak
*.orig
*.swp

# Secrets / credentials (no example/template files ever named this)
**/api_keys.py
**/secrets.txt
**/.env
**/.env.*

# Large local test fixtures (regenerate/download locally, not committed)
**/accessibility_streets.gpkg
**/block.gpkg
**/blockgroup.gpkg

# Generated tiles / rendered map output written by examples
examples/**/tiles/
examples/**/*.pmtiles
examples/**/*.mbtiles
examples/**/*_map.html
